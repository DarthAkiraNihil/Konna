{
  "version": 3,
  "configurePresets": [
    {
      "name": "konna-kernel-base",
      "displayName": "Konna Kernel (LLVM) (base)",
      "hidden": true,
      "generator": "Ninja",
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "LLVM"
        }
      }
    },
    {
      "name": "konna-kernel-base-win",
      "displayName": "Konna Kernel (LLVM) (base, Windows)",
      "inherits": "konna-kernel-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "${sourceDir}/../setup/llvm/bin/clang.exe",
        "CMAKE_CXX_COMPILER": "${sourceDir}/../setup/llvm/bin/clang++.exe"
      }
    },
    {
      "name": "konna-kernel-base-linux",
      "displayName": "Konna Kernel (LLVM) (base, Linux)",
      "hidden": true,
      "inherits": "konna-kernel-base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-20",
        "CMAKE_CXX_COMPILER": "clang++-20"
      }
    },
    {
      "name": "konna-kernel-debug-win",
      "displayName": "Konna Kernel (LLVM, Windows, Debug)",
      "inherits": "konna-kernel-base-win",
      "binaryDir": "${sourceDir}/build/win/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "konna-kernel-release-win",
      "displayName": "Konna Kernel (LLVM, Windows, Release)",
      "inherits": "konna-kernel-base-win",
      "binaryDir": "${sourceDir}/build/win/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "konna-kernel-debug-linux",
      "displayName": "Konna Kernel (LLVM, Linux, Debug)",
      "inherits": "konna-kernel-base-linux",
      "binaryDir": "${sourceDir}/build/linux/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "konna-kernel-release-linux",
      "displayName": "Konna Kernel (LLVM, Linux, Release)",
      "inherits": "konna-kernel-base-linux",
      "binaryDir": "${sourceDir}/build/linux/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ]
}
